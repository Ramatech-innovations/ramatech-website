# Contact form — optional override (default: siteConfig.email in src/lib/seo.ts)
CONTACT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ramatech Website <onboarding@resend.dev>

# Leads sheet (Apps Script web app) — see docs/LEADS-SHEET-SETUP.md
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Auto-reply to the lead (sent only when AUTOREPLY_ENABLED=true)
AUTOREPLY_ENABLED=false
AUTOREPLY_FROM_EMAIL=Ramatech Innovation <info@ramatech.co.in>

# info@ Google Calendar appointment schedule link (booking buttons hidden when empty)
NEXT_PUBLIC_BOOKING_URL=

# Public site URL for canonical URLs, sitemap, and Open Graph (must match live host)
NEXT_PUBLIC_SITE_URL=https://www.ramatech.co.in
